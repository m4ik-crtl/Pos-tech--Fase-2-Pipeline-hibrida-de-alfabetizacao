# Copie para .env e ajuste conforme o ambiente. Nada aqui é obrigatório:
# todos os valores têm padrão em config/pipeline.yml.

# ------------------------------------------------------------------ execução
FORMATO_TABELA=delta          # delta | parquet
SPARK_MASTER=local[*]
SHUFFLE_PARTITIONS=8
LOG_NIVEL=INFO
LOG_FORMATO=texto             # texto | json (json para Azure Monitor)
SEMENTE=42

# ----------------------------------------------------------------- streaming
FONTE_STREAM=kafka            # kafka | arquivo
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPICO=alfabetizacao.eventos.v1

# --------------------------------------------------------------------- nuvem
# Aponta o lakehouse para o Azure Data Lake Storage Gen2 em vez do disco local.
# LAKEHOUSE_URI=abfss://lakehouse@stalfabetizacao.dfs.core.windows.net

# Webhook para alertas de falha (Teams, Slack ou Azure Logic App).
# ALERTA_WEBHOOK=https://...

# Azure Event Hubs falando protocolo Kafka (troca só a configuração):
# KAFKA_BOOTSTRAP_SERVERS=evh-alfabetizacao.servicebus.windows.net:9093
