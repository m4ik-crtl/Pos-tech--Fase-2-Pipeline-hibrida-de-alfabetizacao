# Reduz o contexto de build (era ~15 MB). O que fica de fora é o que a imagem
# não precisa: os serviços montam ./data como volume e o histórico Git não é
# usado em tempo de execução.

.git

# dados: vêm do bind mount `./data:/app/data`, não da imagem
data/lakehouse/
data/_checkpoints/
data/stream_in/
data/_observabilidade/

